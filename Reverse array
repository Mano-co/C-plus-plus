#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int n;
    cout<<"Enter the no of Elements to be filled: ";
    cin>>n;
    int ele;
    vector<int> arr;
    for(int i=0;i<n;i++)
    {
        cout<<"Enter the element in the index "<<"("<<i<<")"<<": ";
        cin>>ele;
        arr.push_back(ele);
    }
    int start,end,temp;
    start=0;
    end=arr.size()-1;
        while(start<end)
        {
            temp=arr[end];
            arr[end]=arr[start];
            arr[start]=temp;
            start++;
            end--;
        }
    for(int i=0;i<arr.size();i++)
    {
        cout<<arr[i]<<" ";
    }
    return 0;
}
