#include<iostream>
using namespace std;
int main()
{
    int number,total=0;
    cout<<"Enter a number:";
    cin>>number;
    for(int i=1;i<number;i++)
    {
        if(number%i==0)
        {
            total+=i;
        }
    }
    if(total==number)
    {
        cout<<"The number is a perfect number";
    }
    else
    {
        cout<<"The number is not a perfect number";
    }
}
