#include<iostream>
using namespace std;
int main(){
    int rows;
    cout<<"Enter the number of rows:";
    cin>>rows;
    for(int z=0;z<2;z++)
    {
    if(z==0)
    {
        int new1;
        new1=(rows/2)+1;
    for(int k=0;k<new1;k++)
    {
    for(int i=new1-k-1;i>0;i--)
    {
        cout<<"0";
    }
    for(int j=0;j<2*k+1;j++)
    {
        cout<<"1";
    }
    for(int i=new1-k-1;i>0;i--)
    {
        cout<<"0";
    }
    cout<<endl;
    }}
    else
    {
        int new1;
        new1=(rows/2)+1;
    for (int k=new1-1;k>0;k--)
    {
        for(int i=0;i<new1-k;i++)
        {
            cout<<"0";
        }
        for(int j=0;j<2*k-1;j++)
        {
            cout<<"1";
        }
        for(int i=0;i<new1-k;i++)
        {
            cout<<"0";
        }
        cout<<endl;
    }
    }
}}
