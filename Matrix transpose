#include<iostream>
using namespace std;
int main()
{
    int m,n;
    cout<<"Enter the matrix rows and columns:";
    cin>>m>>n;
    int mat[m][n],ans[m][n];
    cout<<"Enter the matrix:";
    for(int i=0;i<m;i++)
    {
    for(int j=0;j<n;j++)
    {
    cin>>mat[i][j];    
    }
    cout<<endl;
    }    
    for(int i=0;i<m;i++)
    {
    for(int j=0;j<n;j++)
    {
    ans[j][i]=mat[i][j];    
    }
    } 
    for(int i=0;i<m;i++)
    {
    for(int j=0;j<n;j++)
    {
    cout<<ans[i][j]<<" ";    
    }
    cout<<endl;
    } 
}
