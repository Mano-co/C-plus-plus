#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int n;
    cout<<"Enter the no of Elements to be filled: ";
    cin>>n;
    int temp;
    vector<int> arr;
    for(int i=0;i<n;i++)
    {
        cout<<"Enter the element in the index "<<"("<<i+1<<")"<<": ";
        cin>>temp;
        arr.push_back(temp);
    }
    // int ele=arr[0];
    for(int i=0;i<arr.size();i++)
    {
        for(int j=i+1;j<arr.size();)
        {
            if(arr[i]==arr[j])
            {
                arr.erase(arr.begin()+j);   
            }
            else
            {
                j++;
            }
        }
    }
    for(int i=0;i<arr.size();i++)
    {
        cout<<arr[i]<<" ";
    }
    return 0;
}
