#include<iostream>
#include<cmath>
#include<vector>
using namespace std;
bool isprime(int n){
    if(n<=1)return false;
    else if(n>1)
    {
        for(int i=2;i<=sqrt(n);i++)
        {
            if(n%i==0)
            {
                return false;
            }
        }
    }
    return true;
}
int main()
{
    int n,count=0;
    cout<<"Enter the number of array elements:";
    cin>>n;
    vector<int> arr(n);
    vector<int> out;
    for(int i=0;i<n;i++)
    {
        cout<<"Enter the Element in index"<<i+1<<":";
        cin>>arr[i];
    }
    for(int i=0;i<arr.size();i++)
    {
        if(isprime(arr[i]))
        {
            out.push_back(arr[i]);
        }
    }
    for(int i=0;i<out.size();i++)
    {
        cout<<out[i]<<" ";
    }
}
