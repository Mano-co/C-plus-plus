#include<iostream>
using namespace std;
int factorial(int n)
{
    int fact=1;
    for(int i=1;i<=n;i++)
    {
        fact*=i;
    }
    return fact;
}
int digit(int n)
{
    if(n==0) return 0;
    else
    {
        int digit1=n%10;
        return factorial(digit1) + digit(n/10);
    }
}
int main()
{
    int number,len=0;
    cout<<"Enter a number:";
    cin>>number;
    int total=digit(number);
    if(total==number)
    {
        cout<<number<<" is a strong number";
    }
    else
    {
        cout<<number<<" is not a strong number";
    }
}
