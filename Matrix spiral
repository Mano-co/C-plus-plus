#include<iostream>
using namespace std;
int main()
{
    int m,n;
    cout<<"Enter the matrix rows and columns:";
    cin>>m>>n;
    int mat[m][n];
    cout<<"Enter the matrix:";
    for(int i=0;i<m;i++)
    {
    for(int j=0;j<n;j++)
    {
    cin>>mat[i][j];    
    }
    }
    int top=0;
    int bottom=m;
    int right=n;
    int left=0;
    while(top<bottom && left<right)
    {
        for(int i=left;i<right;i++)
        {
            cout<<mat[top][i]<<" ";
        }top++;
        for(int i=top;i<bottom;i++)
        {
            cout<<mat[i][right-1]<<" ";
        }right--;
        if(top<bottom)
        {
        for(int i=right-1;i>=left;i--)
        {
            cout<<mat[bottom-1][i]<<" ";
        }
        }bottom--;
        if(left<right)
        {
        for(int i=bottom-1;i>=top;i--)
        {
            cout<<mat[i][left]<<" ";
        }
        }left++;
    }cout<<endl;
}    
