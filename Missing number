#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
    int n;
    cout<<"Enter the no of elements:";
    cin>>n;
    int temp,total=0;
    total=(n*(n+1))/2;
    vector<int> arr;
    for(int i=0;i<n;i++)
    {
        cout<<"Enter the element in the index "<<"("<<i+1<<")"<<": ";
        cin>>temp;
        arr.push_back(temp);
    }
    int count=0,dif;
    for(int i=0;i<arr.size();i++)
    {
        count+=arr[i];
    }
    dif=total-count;
    arr.push_back(dif);
    sort(arr.begin(),arr.end());
    for(int i=0;i<arr.size();i++)
    {
        cout<<arr[i]<<" ";
    }
    return 0;
}
