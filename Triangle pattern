#include<iostream>
using namespace std;
int main()
{
    int rows;
    cout<<"Enter the number of rows:";
    cin>>rows;
    for(int k=1;k<=rows;k++)
    {
    for(int i=rows-k;i>0;i--)
    {
        cout<<" ";
    }
    for(int i=0;i<k-1;i++)
    {
        cout<<"* ";
    }
    cout<<endl;
    }
}
