#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int n;
    cout<<"Enter the no of Elements to be filled: ";
    cin>>n;
    int ele;
    vector<int> arr;
    for(int i=0;i<n;i++)
    {
        cout<<"Enter the element in the index "<<"("<<i<<")"<<": ";
        cin>>ele;
        arr.push_back(ele);
    }
    int smallest=arr[0];
    for(int i=1;i<n;i++)
    {
        if(smallest>arr[i])
        {
            smallest=arr[i];
        }
    }
    cout<<"This is the smallest number in the array: "<<smallest;
}
