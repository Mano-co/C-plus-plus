#include<iostream>
using namespace std;
int main()
{
    int num,output=0;
    cout<<"Enter the number of elements to be entered:";
    cin>>num;
    int input;
    for(int i=0;i<num;i++)
    {
        cout<<"Enter a 4 digit number:";
        cin>>input;   
        int max=0;
        int min=9;
        while(input>0)
    {
        int rem=input%10;
        if(rem>max)
        {
            max=rem;
        }
        if(rem<min)
        {
            min=rem;
        }
        input/=10;
    }    
    cout<<max<<" "<<min<<endl;
    output+=max-min;
    cout<<output;
    }
}
