#include<iostream>
#include<vector>
using namespace std;
int main()
{
    int n;
    cout<<"Enter the no of elements:";
    cin>>n;
    int temp;
    vector<int> arr;
    for(int i=0;i<n;i++)
    {
        cout<<"Enter the element in the index "<<"("<<i+1<<")"<<": ";
        cin>>temp;
        arr.push_back(temp);
    }
    int count=0;
    for(int i=0;i<arr.size();)
    {
        if(arr[i]==0)
        {
            arr.erase(arr.begin()+i);
            count+=1;
        }
        else
        {
            i++;
        }
    }
    for(int i=0;i<count;i++)
    {
        arr.push_back(0);
    }
    for(int i=0;i<arr.size();i++)
    {
        cout<<arr[i]<<" ";
    }
    return 0;
}
